<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F5FA">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Foco" android:textSize="34sp" android:textStyle="bold" android:textColor="#222222"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu espacio para concentrarte." android:textSize="16sp" android:textColor="#666666" android:layout_marginBottom="18dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="#FFFFFF">
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="○ Concentración desactivada" android:textSize="15sp" android:textStyle="bold"/>
<TextView android:id="@+id/timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Listo para empezar" android:textSize="25sp" android:textStyle="bold" android:layout_marginTop="7dp"/>
<Button android:id="@+id/focusButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Empezar a concentrarme" android:layout_marginTop="14dp"/>
<Button android:id="@+id/timeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Duración: 45 minutos" android:layout_marginTop="6dp"/>
<Switch android:id="@+id/strictSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Modo estricto" android:textSize="16sp" android:layout_marginTop="6dp"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Primera vez que lo usás" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="24dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Foco necesita el permiso de Accesibilidad para detectar cuándo abrís una app bloqueada." android:textSize="14sp" android:textColor="#666666" android:layout_marginTop="4dp"/>
<Button android:id="@+id/accessibilityButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Configurar permiso de Accesibilidad" android:layout_marginTop="8dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="26dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Apps a bloquear" android:textSize="22sp" android:textStyle="bold"/>
<TextView android:id="@+id/selectedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 apps seleccionadas" android:textSize="13sp"/>
</LinearLayout>
<EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Buscar una app…" android:inputType="text" android:singleLine="true" android:layout_marginTop="8dp"/>
<LinearLayout android:id="@+id/appsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp"/>
</LinearLayout></ScrollView>
